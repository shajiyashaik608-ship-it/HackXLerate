# ==============================================================================
# Health Saathi (PCOS Saathi) - Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="Health Saathi"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000

# Security & Authentication
# Note: Either JWT_SECRET_KEY or SECRET_KEY can be provided (min 32 characters)
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="your-super-secure-random-jwt-secret-min-32-chars-long"
SECRET_KEY="your-super-secure-random-jwt-secret-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# Database Configuration (Supabase PostgreSQL / Local SQLite)
# ==============================================================================
# 1. Supabase Transaction-Mode Pooler (Port 6543) - Normal Application Operations
DATABASE_URL="postgresql+psycopg://postgres.sgtcudpolarsobgldlmu:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Session-Mode Pooler (Port 5432) - Direct / Alembic Migrations
DIRECT_URL="postgresql+psycopg://postgres.sgtcudpolarsobgldlmu:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional: Local SQLite for zero-config local unit testing
# DATABASE_URL="sqlite:///./health_saathi.db"

# Connection Pool Tuning (Optimized for Supabase Transaction Pooler)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Private Storage & Uploads
UPLOAD_DIR="./uploads/private"
MAX_UPLOAD_SIZE_MB=10

# AI / LLM Configuration
# Options: "mock", "gemini", "openai"
LLM_PROVIDER="mock"
LLM_MODEL="gemini-1.5-flash"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# OCR Settings
TESSERACT_CMD=""

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Demonstration Settings (Auto-disabled in production)
DEMO_MODE=true
ENABLE_DEMO_SEED=true
DEMO_USER_EMAIL="priya@healthsaathi.in"
DEMO_USER_PASSWORD="DemoUserPassword123!"

