DATABASE_URL=postgresql+psycopg://postgres.sgtcudpolarsobgldlmu:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Session-Mode Pooler (Port 5432) for Migrations
DIRECT_URL=postgresql+psycopg://postgres.sgtcudpolarsobgldlmu:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
